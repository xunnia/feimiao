<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_categories_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_feimiao_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_categories_book"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="肥喵记账"
            android:textColor="#191A1C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_categories_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:includeFontPadding="false"
            android:text="今日"
            android:textColor="#797B80"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_categories_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_add_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="#191A1C"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_categories_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:includeFontPadding="false"
        android:text="分类与支出活动"
        android:textColor="#74777D"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="7dp"
        android:background="#14000000" />

    <TextView
        android:id="@+id/widget_categories_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:text="打开 App 后同步最近支出"
        android:textColor="#8C8E93"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_category_row_1"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_category_dot_1"
                android:layout_width="13dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="●"
                android:textColor="#2F3135"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_category_name_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#191A1C"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_category_amount_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#191A1C"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_category_percent_1"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:includeFontPadding="false"
                android:textColor="#8C8E93"
                android:textSize="10sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_category_progress_1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginLeft="13dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_category_row_2"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_category_dot_2"
                android:layout_width="13dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="●"
                android:textColor="#4876E8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_category_name_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#191A1C"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_category_amount_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#191A1C"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_category_percent_2"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:includeFontPadding="false"
                android:textColor="#8C8E93"
                android:textSize="10sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_category_progress_2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginLeft="13dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_category_row_3"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_category_dot_3"
                android:layout_width="13dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="●"
                android:textColor="#1F9A69"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_category_name_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#191A1C"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_category_amount_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#191A1C"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_category_percent_3"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:includeFontPadding="false"
                android:textColor="#8C8E93"
                android:textSize="10sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_category_progress_3"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginLeft="13dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="7dp"
        android:background="#14000000" />

    <TextView
        android:id="@+id/widget_categories_show_all"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical|right"
        android:includeFontPadding="false"
        android:text="查看所有"
        android:textColor="#74777D"
        android:textSize="11sp" />
</LinearLayout>
