<?xml version="1.0" encoding="utf-8"?>
<!-- 根容器透明：渲染 PNG 里自带白卡，外层再铺白底会套娃出一大圈空白；
     比例对不上时 fitCenter 的留白直接透出壁纸，观感正常。白卡背景只给文字兜底层。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_rendered_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="false"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_fallback_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_feimiao_bg"
        android:gravity="top"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/widget_add_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="74dp"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:text="2026年7月"
            android:textColor="#191A1C"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_stats_button"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/widget_add_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingLeft="9dp"
            android:paddingRight="8dp"
            android:text="统计 ›"
            android:textColor="#191A1C"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_book_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="right|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="肥喵记账"
            android:textColor="#8A8D92"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_add_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/widget_add_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="#191A1C"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_main_metrics"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_primary_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="支出"
                android:textColor="#8A8D92"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_month_expense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="--"
                android:textColor="#161719"
                android:textSize="23sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="42dp"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:background="#1A1A1C22" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_secondary_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="收入"
                android:textColor="#8A8D92"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_month_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="--"
                android:textColor="#1F9A69"
                android:textSize="23sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_budget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="10dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_bottom_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="结余 --"
            android:textColor="#74777D"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_today_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="今日 --"
            android:textColor="#74777D"
            android:textSize="11sp" />
    </LinearLayout>

    </LinearLayout>

</FrameLayout>
