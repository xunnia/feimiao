<?xml version="1.0" encoding="utf-8"?>
<!--
  GPT/Codex OAuth registers an HTTP loopback redirect. User-configured AI
  relays may also be local/private HTTP services; the Dart URL policy and
  AiHttpTransport keep public cleartext hosts blocked. HTTPS remains the
  preferred/default protocol.
-->
<network-security-config>
    <!-- Android has no CIDR syntax for private IP ranges. The application
         layer allowlist above is the security boundary for cleartext AI
         requests, so the socket policy must allow the permitted LAN hosts. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
