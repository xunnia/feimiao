<?xml version="1.0" encoding="utf-8"?>
<!--
  GPT/Codex OAuth registers an HTTP loopback redirect. Keep cleartext denied
  everywhere else while allowing the app-owned Android WebView to reach the
  short-lived listener on this device.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
